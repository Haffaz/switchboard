# Copy to release.local.env (gitignored) and fill in to sign your own builds.
# List your certificates with: security find-identity -v -p codesigning
TEAM_ID="XXXXXXXXXX"
SIGN_IDENTITY="Developer ID Application: Your Name (XXXXXXXXXX)"
# Name you gave to: xcrun notarytool store-credentials <name> --apple-id … --team-id …
NOTARY_PROFILE="switchboard-notary"
