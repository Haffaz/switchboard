# Project settings for Switchboard. Safe to commit: nothing personal here.
# Signing details live in release.local.env (see release.local.env.example).
APP_NAME="Switchboard"
BUNDLE_ID="io.github.haffaz.switchboard"
VERSION="1.0.1"
MIN_MACOS="14.0"

# Where releases are published, and the Homebrew tap that points at them.
# `brew install --cask haffaz/tap/switchboard` reads <TAP_REPO>/Casks/switchboard.rb.
GITHUB_REPO="Haffaz/switchboard"
TAP_REPO="Haffaz/homebrew-tap"
