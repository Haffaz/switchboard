# Homebrew cask for Switchboard. Generated by publish.sh from
# packaging/switchboard.rb.template; do not edit the copy in the tap by hand.
cask "switchboard" do
  version "@VERSION@"
  sha256 "@SHA256@"

  url "https://github.com/@REPO@/releases/download/v#{version}/Switchboard-#{version}.dmg"
  name "Switchboard"
  desc "Run several Claude accounts side by side"
  homepage "https://github.com/@REPO@"

  depends_on macos: :sonoma

  app "Switchboard.app"
  # Puts the cprof command on your PATH.
  binary "#{appdir}/Switchboard.app/Contents/MacOS/cprof"

  uninstall quit: "@BUNDLE_ID@"

  # `brew uninstall --zap` also removes every account you added, with its
  # history. Your original Claude setup (~/.claude) is never touched.
  zap trash: [
    "~/.claude-profiles",
    "~/Library/Logs/Switchboard.log",
    "~/Library/Preferences/@BUNDLE_ID@.plist",
  ]

  caveats <<~EOS
    Switchboard lives in your menu bar. Open it once from Applications,
    then switch on "Open at login" under Settings, General to keep it there.

    Not affiliated with Anthropic.
  EOS
end
